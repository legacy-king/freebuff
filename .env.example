[TEMPLATE]
# ── Database ──────────────────────────────────────────────────────────────
DATABASE_URL=postgres://freebuff:freebuff@localhost:5432/freebuff
REDIS_URL=redis://localhost:6379

# ── Control Plane ────────────────────────────────────────────────────────
API_HOST=0.0.0.0
API_PORT=3001

# ── API Gateway ──────────────────────────────────────────────────────────
GATEWAY_HOST=0.0.0.0
GATEWAY_PORT=8000

# ── Auth ─────────────────────────────────────────────────────────────────
JWT_SECRET=dev-secret-change-in-production
JWT_EXPIRATION_SECS=3600

# ── Database Proxy ───────────────────────────────────────────────────────
PROXY_HOST=0.0.0.0
PROXY_PORT=5433
MAX_CONNECTIONS_PER_PROJECT=100

# ── Object Storage (MinIO/S3) ────────────────────────────────────────────
S3_ENDPOINT=http://localhost:9000
S3_BUCKET=freebuff
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin

# ── Region ───────────────────────────────────────────────────────────────
DEFAULT_REGION=us-east-1

# ── WAL Service (Neon-inspired storage engine) ───────────────────────────
WAL_HOST=0.0.0.0
WAL_PORT=5001
WAL_DIR=./wal_data
ARCHIVE_INTERVAL_SECS=60

# WAL Service S3 (separate bucket for WAL archives)
WAL_S3_BUCKET=freebuff-wal

# ── Branch Service (pg_basebackup-based branching) ───────────────────────
BRANCH_DATA_DIR=./branch_data

# ── Service URLs (for inter-service communication) ───────────────────────
WAL_SERVICE_URL=http://localhost:5001
BRANCH_SERVICE_URL=http://localhost:5002
CONTROL_PLANE_URL=http://localhost:3001

# ── Billing & Usage Metering (Stripe) ────────────────────────────────────
# Stripe secret key (sk_...). Leave empty to disable billing.
STRIPE_SECRET_KEY=
# Stripe webhook signing secret (whsec_...) for /v1/billing/webhook.
STRIPE_WEBHOOK_SECRET=
# Base plan price ID (price_...) used when creating the checkout subscription.
STRIPE_PRICE_ID=
# Billing Meter event names — must match the meters configured in the
# Stripe dashboard, with customer mapping set to payload.stripe_customer_id.
STRIPE_METER_STORAGE=freebuff_storage_gb
STRIPE_METER_COMPUTE=freebuff_compute_hours
STRIPE_METER_API_CALLS=freebuff_api_calls

# ── Internal Service Auth ────────────────────────────────────────────────
# Token used by services (e.g. the gateway) to report usage to the control plane.
INTERNAL_API_TOKEN=dev-internal-token-change-me

# ── Database Storage Metering ────────────────────────────────────────────
# How often (seconds) the control plane samples pg_database_size() per active
# project. Set to 0 to disable sampling.
STORAGE_SAMPLE_SECS=300
# Credentials used to connect to each project's database for size sampling.
PG_MONITOR_USER=freebuff
PG_MONITOR_PASSWORD=freebuff